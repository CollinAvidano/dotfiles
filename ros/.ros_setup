### Useful Functions
# Color ros2
# THIS IS WHAT WAS CAUSING ALL MY WEIRD ROS2 ISSUES. NEVER USE IT DIRECTLY IN PLACE OF ROS2
ros2color() {
    \ros2 "$@" | sed -E '
        /FATAL/ s/^.*$/\x1b[1;31m&\x1b[0m/;
        /ERROR/ s/^.*$/\x1b[31m&\x1b[0m/;
        /WARN/  s/^.*$/\x1b[33m&\x1b[0m/;
        /INFO/  s/^.*$/\x1b[32m&\x1b[0m/
    '
}

# better bag info that actually sorts the topics
alias bagtopics="ros2-bagtopics"
ros2-bagtopics() {
    ros2 bag info "$@" | awk '{ $1=""; sub(/^ /,""); print }' | sort
}

# because my brain wont let go of ros1 stuff
alias rostopic="ros2 topic"
alias roslaunch="ros2 launch"
alias rosbag="ros2 bag"

alias watch-topics="watch -d -n 1 ros2 topic list"
alias watch-nodes="watch -d -n 1 ros2 node list"
alias restart-daemon="ros2 daemon stop && pkill ros2 && ros2 daemon start"

alias ros-clear-env='unset COLCON_WS ROS_VERSION ROS_PYTHON_VERSION ROS_DISTRO AMENT_PREFIX_PATH COLCON_PREFIX_PATH PYTHONPATH CMAKE_PREFIX_PATH'

# basically use use --start and --end after this
alias bag-cut="ros2 bag cut --out-storage mcap -o cut"
alias bag-merge='printf "output_bags:\n- uri: output_bags\n  storage_id: mcap\n  all: true\n" > out.yaml; ros2 bag convert -i lidar_topics*/ -i other_topics*/ -i out.yaml; rm  out.yaml'

alias chown-drives="sudo chown -R $USER:$USER /media/$USER/"

mas-install() {
    # resolve the real ros/ dotfiles dir (this file is symlinked from ~/.ros_setup)
    # so the install script is found regardless of where it's sourced from.
    local _dir; _dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$HOME/.ros_setup}")")"
    "$_dir/install-mas.sh" || { echo "mas: install check failed" >&2; return 1; }
}

# Normal Electron GUI desktop app. Pass --ros-domain-id explicitly: the GUI picks
# the daemon's websocket port as 35430+domain, but its --ros-domain-id defaults to
# -1 (the ROS_DOMAIN_ID fromEnv fallback is unreliable), so without this it tries
# port 35429 and the provider shows "closed".
mas() {
    mas-install
    setsid mas-gui --ros-domain-id="${ROS_DOMAIN_ID:-0}" >/tmp/mas-gui.log 2>&1 &
}

# Headless web server (:6275), then open the browser. Same --ros-domain-id fix.
mas-web() {
    local url="http://localhost:6275"
    mas-install
    pgrep -f 'mas-gui.*--headless' >/dev/null \
        || { echo "starting mas-gui --headless ($url)..."; setsid mas-gui --headless --ros-domain-id="${ROS_DOMAIN_ID:-0}" >/tmp/mas-gui.log 2>&1 & }
    # wait for the web server to come up, then open the default browser
    for _ in $(seq 1 40); do (exec 3<>/dev/tcp/localhost/6275) 2>/dev/null && { exec 3>&- 3<&-; break; }; sleep 0.5; done
    xdg-open "$url" >/dev/null 2>&1 &
}



